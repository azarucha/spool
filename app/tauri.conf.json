{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Spool",
  "version": "0.9.1",
  "identifier": "io.github.azarucha.spool",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "publisher": "Spool",
    "shortDescription": "Filme, Serien und Musik nach Plex",
    "category": "Utility",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "startMenuFolder": "Spool"
      }
    },
    "resources": {
      "../THIRD-PARTY.txt": "THIRD-PARTY.txt",
      "../LICENSE": "LICENSE.txt"
    },
    "license": "MIT"
  }
}
